# Copy to .env.local and fill in. Never commit real values.

# Postgres (local: `pnpm db:up`; production: Neon *pooled* URL)
DATABASE_URL=postgres://booker:booker@localhost:5432/booker
# Used by Vitest/Playwright; must point to a disposable database
TEST_DATABASE_URL=postgres://booker:booker@localhost:5432/booker_test

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Email. Without RESEND_API_KEY, emails are written as JSON to EMAIL_DIR
# (default .emails/) instead of being sent. Production needs both values below.
RESEND_API_KEY=
EMAIL_FROM="Booker <no-reply@tu-dominio.bo>"
